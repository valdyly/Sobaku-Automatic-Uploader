{
  "name": "sobaku-automatic-uploader",
  "version": "2.0.0",
  "description": "Enterprise Multi-platform Music Video Auto Uploader & Scheduler by Sobaku",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.sobaku.autouploader",
    "productName": "Sobaku Automatic Uploader Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "googleapis": "^137.0.0",
    "node-cron": "^3.0.3"
  }
}